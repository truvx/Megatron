#!/bin/zsh
set -u

source "$HOME/.config/nvidia/env" || exit 1
export LITELLM_MASTER_KEY="$(cat "$HOME/.config/nvidia/litellm-master-key")"

if ! curl -fsS -H "Authorization: Bearer $(cat "$HOME/.config/nvidia/litellm-master-key" 2>/dev/null)" http://127.0.0.1:4000/health >/dev/null 2>&1; then
  nohup "$HOME/.venvs/nvidia-claude/bin/litellm" \
    --config "$HOME/.config/nvidia/litellm.yaml" \
    --port 4000 \
    > "$HOME/.config/nvidia/litellm.log" 2>&1 < /dev/null &

  for i in {1..30}; do
    if curl -fsS -H "Authorization: Bearer $LITELLM_MASTER_KEY" http://127.0.0.1:4000/health >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
fi

if ! curl -fsS -H "Authorization: Bearer $LITELLM_MASTER_KEY" http://127.0.0.1:4000/health >/dev/null 2>&1; then
  echo "LiteLLM did not start. Check ~/.config/nvidia/litellm.log"
  exit 1
fi

export ANTHROPIC_BASE_URL="http://127.0.0.1:4000"
export ANTHROPIC_AUTH_TOKEN="$LITELLM_MASTER_KEY"
export ANTHROPIC_MODEL="nemotron"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="nemotron"
export ANTHROPIC_DEFAULT_SONNET_MODEL="nemotron"
export ANTHROPIC_DEFAULT_OPUS_MODEL="nemotron"
unset ANTHROPIC_API_KEY

claude --model nemotron
